# Secret used to sign copilote session cookies. Generate a long random value
# before deploying (e.g. `openssl rand -base64 32`). Never reuse the dev default.
SESSION_SECRET=

# Optional: POST endpoint (HubSpot/Brevo/Salesforce workflow, etc.) that
# receives every captured lead as JSON. Leave empty to keep leads local-only
# (still visible in the copilote dashboard / SQLite store).
CRM_WEBHOOK_URL=

# Optional: commission amount (in euros) credited per qualified lead. Defaults to 50.
COMMISSION_PAR_LEAD=50
